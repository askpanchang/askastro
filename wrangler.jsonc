{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kundali-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  // global_fetch_strictly_public: the AskPanchang API is a Worker in the same
  // account; without this flag Cloudflare blocks Worker-to-Worker fetch()
  // (it needs a service binding otherwise) and generation fails in production.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kundali-studio",
      // Production database (APAC). Local dev and tests use a local copy.
      "database_id": "fd888024-a97c-47d0-b25d-73333b057d74",
      "migrations_dir": "migrations",
    },
  ],
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "APP_NAME": "Kundali Studio",
    "ASKPANCHANG_API_BASE": "https://askpanchang-api-edge.askpanchang.workers.dev",
    // Header used for the optional ASKPANCHANG_API_KEY secret.
    "ASKPANCHANG_API_KEY_HEADER": "x-api-key",
    // Provisional; verify against the current Workers AI catalog (see CLAUDE.md).
    "AI_MODEL": "@cf/openai/gpt-oss-120b",
    "AI_GATEWAY_ID": "",
    // Cloudflare Access team domain (JWT issuer). The application audience,
    // ACCESS_AUD, is a production-only secret: without it (local dev, tests)
    // the owner comes from the Cf-Access-Authenticated-User-Email header.
    "ACCESS_TEAM_DOMAIN": "https://ask-panchang.cloudflareaccess.com",
    // Per-owner sliding one-hour limits.
    "RATE_LIMIT_QUESTIONS_PER_HOUR": "30",
    "RATE_LIMIT_KUNDALIS_PER_HOUR": "20",
    // Non-admin (family) users: questions per hour.
    "RATE_LIMIT_FAMILY_QUESTIONS_PER_HOUR": "10",
    // Workers AI free allowance in neurons per day (reset 00:00 UTC), shown on
    // the Usage page. Admins have no app cap (free allowance + any credits);
    // everyone else gets AI_USER_DAILY_NEURONS per day.
    "AI_DAILY_NEURON_BUDGET": "10000",
    "AI_USER_DAILY_NEURONS": "5000",
    // For the account-wide usage figure (Cloudflare GraphQL analytics). Needs the
    // CF_ANALYTICS_TOKEN secret (Account Analytics: Read only); else an estimate.
    "CF_ACCOUNT_ID": "2f209d94239e556224c9f71e6775cf36",
  },
  // Served only on kundali-studio.askpanchang.workers.dev, which Cloudflare
  // Access protects. Preview URLs would be extra, unprotected hostnames.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
}
