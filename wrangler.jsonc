{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kundali-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kundali-studio",
      // Placeholder for local dev and tests. Replace with the real ID from
      // `wrangler d1 create kundali-studio` before deploying (Phase 5).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "APP_NAME": "Kundali Studio",
    "ASKPANCHANG_API_BASE": "https://askpanchang-api-edge.askpanchang.workers.dev",
    // Header used for the optional ASKPANCHANG_API_KEY secret.
    "ASKPANCHANG_API_KEY_HEADER": "x-api-key",
    // Provisional; verify against the current Workers AI catalog (see CLAUDE.md).
    "AI_MODEL": "@cf/openai/gpt-oss-120b",
    "AI_GATEWAY_ID": "",
    // Cloudflare Access: set both in production (Phase 5). Empty = local dev
    // (owner from the Cf-Access-Authenticated-User-Email header, else "default").
    "ACCESS_AUD": "",
    "ACCESS_TEAM_DOMAIN": "",
    // Per-owner sliding one-hour limits.
    "RATE_LIMIT_QUESTIONS_PER_HOUR": "30",
    "RATE_LIMIT_KUNDALIS_PER_HOUR": "20",
  },
  "observability": { "enabled": true },
}
